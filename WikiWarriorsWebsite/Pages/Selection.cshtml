@page
@model WikiWarriorsWebsite.Pages.SelectionModel
@{
    ViewData["Title"] = "Selection";
}
<script>
    function Selection(SelectionID) {
        document.getElementById("img1").src = SelectionID;
        document.getElementById("img2").src = SelectionID;

        console.log(SelectionID);
    }
</script>

<form method="post">
    <div class="searchBar">
        <input asp-for="Name" />
        <button type="submit">Search</button>
    </div>

    <div class="fighterSelection">
        <img id="img1" src="" alt="Fighter 1" />
    </div>

    @if (Model.Results?.Count > 0)
    {
        <h3>Results</h3>

        <div class="playerCards">
            @foreach (var result in Model.Results)
            {
                <label class="playerCard">
                    <input class="cardRadio"
                           name="PageId"
                           type="radio"
                           value="@result.PageId" onclick="Selection('@result.ImageUrl.Source')"/>

                    <img src="@result.ImageUrl.Source" alt="@result.Title" />

                    <div class="cardTitle">@result.Title</div>
                    <p class="cardDescription">@result.Description</p>
                </label>
            }
        </div>

    }
</form>



