@page
@model WikiWarriorsWebsite.Pages.SelectionModel
@{
    ViewData["Title"] = "Selection";
}
<script>
    // Content loaded listenter
    document.addEventListener("DOMContentLoaded", documentReady);

    function Selection(ImageUrl, PageId) {

        if (!sessionStorage.getItem("ImageUrl1")) {

            document.getElementById("img1").src = ImageUrl;
            sessionStorage.setItem("ImageUrl1", ImageUrl);
        }
        else {

            document.getElementById("img2").src = ImageUrl;
            sessionStorage.setItem("ImageUrl2", ImageUrl);
        }
        console.log(SelectionID);
    }

    function documentReady() {
        
        if (sessionStorage.getItem("ImageUrl1")) {

            ImageUrl = sessionStorage.getItem("ImageUrl1")
            document.getElementById("img1").src = ImageUrl;
        }
        if (sessionStorage.getItem("ImageUrl2")) {

            ImageUrl = sessionStorage.getItem("ImageUrl2")
            document.getElementById("img2").src = ImageUrl;
        }


    }
</script>

<form method="post">
    <div class="searchBar">
        <input asp-for="Name" />
        <button type="submit">Search</button>
    </div>

    <div class="fighterSelection">
        <img id="img1" src="" alt="Fighter 1" />
        <img id="img2" src="" alt="Fighter 2" />
    </div>
    <br />
    <button type="submit" name="makeFight">Make Fight!</button>
    <div>
        <p class="debug">
            
        </p>
    </div>

    @if (Model.Results?.Count > 0)
    {
        <h3>Results</h3>

        <div class="playerCards">
            @foreach (var result in Model.Results)
            {
                <label class="playerCard">
                    <input class="cardRadio"
                           name="PageId"
                           type="radio"
                           value="@result.PageId" onclick="Selection('@result.ImageUrl.Source', @result.PageId, @result.ArticleUrl, @result.Title)"/>

                    <img src="@result.ImageUrl.Source" alt="@result.Title" />

                    <div class="cardTitle">@result.Title</div>
                    <p class="cardDescription">@result.Description</p>
                </label>
            }
        </div>

    }
</form>



