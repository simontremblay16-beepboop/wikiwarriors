@page
@model WikiWarriorsWebsite.Pages.SelectionModel
@{
    ViewData["Title"] = "Selection";
}

<form method="post">
    <input asp-for="Name" />
    <button type="submit">Search</button>
</form>

@if (Model.Results?.Count > 0)
{
    <h3>Results</h3>

    <table>
        <thead>
            <tr>
                <td>Preview</td>
            </tr>
            <tr>
				<td>Title</td>
            </tr>
            <tr>
                <td>Description</td>
            </tr>
            
        </thead>
        <tbody>
        @foreach (var result in Model.Results)
        {
            <input type="hidden" value="@result.PageId"/>
            <tr>
                <td><img src="@result.ImageUrl.Source"/></td>
            </tr>
            <tr>
                <td>@result.Title</td>
            </tr>
                <tr>
                    <td>@result.Description</td>
                </tr>
        }
        </tbody>
    </table>
}






