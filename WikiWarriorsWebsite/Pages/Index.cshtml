@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}
<script src="~/js/Index.js"></script>
<div hidden>
    DEBUG INFO:
    <p>Current Date: <span id="currentDate"></span></p>
    <p>Last Daily Fight: <span id="lastDate"></span></p>
    <p>Article of the day: @ViewData["featuredArticle"]</p>
    <p>In the news: @ViewData["inTheNews"]</p>
    <p id="dailyFightDate">@ViewData["dailyFightDate"]</p>
</div>

<div class="text-center">
    <div class="mainP">
        <p>
            Welcome to WIKI WARRIORS. A website all about sending wikipedia pages to
            "Fight" (Have a friendly competition) to the "Death" (Fainting, we don't condone violence)
        </p>
        <hr />
    </div>

    <div class="divFightOfTheDay">

        <h1>Fight of the day #@ViewData["dailyFightsId"]</h1>

        <h4>
            Winner: @ViewData["dailyFightWinnerName"]
            (@ViewData["dailyFightDate"])
        </h4>
        <br />

        <div class="divRow">
            <div class="fighterDisplay">
                <p class="fighterName">@ViewData["dailyFightFighter1Name"]</p>
                <a href="@ViewData["dailyFighter1Url"]">
                    <img src="@ViewData["dailyFightFighter1ImageUrl"]"
                         class="decorationImage"
                         alt="Fighter 1"
                         style="max-width: 100%" />
                </a>
            </div>

            <img src="~/swordLeft.png"
                 class="decorationImage"
                 alt="Sword"
                 style="max-width:25%" />

                 <span class="vs">VS</span>

            <img src="~/swordRight.png"
                 class="decorationImage"
                 alt="Sword"
                 style="max-width:25%" />

            <div class="fighterDisplay">
                <p class="fighterName">@ViewData["dailyFightFighter2Name"]</p>
                <a href="@ViewData["dailyFighter2Url"]">
                    <img src="@ViewData["dailyFightFighter2ImageUrl"]"
                     class="decorationImage"
                     alt="Fighter 2" 
                         style="max-width: 100%" />
                </a>
            </div>
        </div>
    </div>
    <h2 class="TableSumm">Fight History:</h2>
    <p class="TableSumm">These are all the fights that have been created around the world by your fellow Wiki Warriors!</p>
</div>

@if (Model.FightHistory != null && Model.FightHistory.Count > 0)
{
    <div class="globalFightsTable">
        <table class="fightTable">
            <colgroup>
                <col class="colDate" />
                <col class="colFighter" />
                <col class="colFighter" />
                <col class="colWinner" />
                <col class="colDaily" />
            </colgroup>

            <thead>
                <tr>
                    <th>Fight Date</th>
                    <th>Fighter 1</th>
                    <th>Fighter 2</th>
                    <th>Winner</th>
                    <th>Daily Match?</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model.FightHistory.OrderByDescending(f => f.FightDate).Take(5))
                {
                    <tr>
                        <td>
                            <span class="tableText">@item.FightDate.ToString("yyyy-MM-dd")</span>
                        </td>

                        <td><a class="tableLink" href="@item.Fighter1.PageUrl">@item.Fighter1.Name</a>
                        </td>

                        <td><a class="tableLink" href="@item.Fighter2.PageUrl">@item.Fighter2.Name</a>
                        </td>

                        <td>
                            <span class="tableText">@item.Winner.Name</span>
                        </td>

                        <td>
                            @if (item.DailyFight)
                            {
                                <input type="checkbox" checked disabled />
                            }
                            else
                            {
                                <input type="checkbox" disabled />
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}